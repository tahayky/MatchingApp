# MongoDB Connection String
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret Key for signing tokens
JWT_SECRET=your_strong_jwt_secret_here_please_generate_a_secure_one

# Admin Credentials for backend validation
ADMIN_USERNAME=admin_example
ADMIN_PASSWORD=password_example

# Admin Panel Origin URL (for CORS configuration in src/app.ts)
# Replace with the actual URL your admin panel runs on (e.g., http://localhost:3001 or your production admin URL)
ADMIN_PANEL_ORIGIN_URL=http://localhost:3001

# Supabase Configuration for Storage
# Get these from your Supabase project dashboard
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostgreSQL Connection (if using Supabase database directly)
SUPABASE_URI=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres